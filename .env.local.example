# Copiar este archivo a .env.local para configuración local de Pusher
# Configuración para desarrollo con Pusher (cuenta gratuita)

# Pusher Configuration - Desarrollo
PUSHER_APP_ID=123456
PUSHER_APP_KEY=abcdefg123456
PUSHER_APP_SECRET=abcdef123456
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# Broadcasting Driver
BROADCAST_DRIVER=pusher

# Variables para Vite
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Instrucciones:
# 1. Crear cuenta gratuita en https://pusher.com
# 2. Crear nueva aplicación "Channels"
# 3. Copiar las credenciales aquí
# 4. Ejecutar: npm run dev y php artisan serve
